    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
